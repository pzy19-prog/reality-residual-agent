  "registration_sql": [
    "CREATE DATASOURCE RRA_L3_TELEMETRY DESCRIBE BY \"L3 whitelisted policy telemetry\" OPTIONS (jdbcdriver \"org.postgresql.Driver\", jdbcurl \"jdbc:postgresql://rra-l3-pg:5432/rra_telemetry\", username \"postgres\", password \"\")",
    "CREATE LIGHTNING DATABASE RRA_L3_OPS DESCRIBE BY \"L3 whitelisted operational context\"",
    "CREATE LIGHTNING REST TABLE known_config FROM RRA_L3_OPS REQUEST(endpoint \"http://rra-l3-ops:8000/known_config\", method \"get\", response_type \"json\", http_encoding \"URLENCODED\") HEADER () BODY ()",
    "CREATE LIGHTNING REST TABLE ops_context FROM RRA_L3_OPS REQUEST(endpoint \"http://rra-l3-ops:8000/ops_context\", method \"get\", response_type \"json\", http_encoding \"URLENCODED\") HEADER () BODY ()"
  ],
